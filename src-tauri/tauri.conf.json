{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Backup",
  "mainBinaryName": "claude-backup",
  "version": "1.0.0",
  "identifier": "com.hallonsaftt.claudebackup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Backup",
        "width": 1120,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Sigurna kopija Claude razgovora, podešavanja i skillova",
    "longDescription": "Pravi potpun, proveren (SHA-256) backup Claude Code i Cowork istorije. Claude fajlove samo čita — ništa ne briše i ne menja.",
    "copyright": "© 2026 hallonsaftt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
